# Port the API listens on (default: 3001)
PORT=3001
# Browser origin allowed to call the API via CORS (default: http://localhost:3000)
WEB_ORIGIN=http://localhost:3000
# PostgreSQL connection string (required). Replace the placeholders; never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/career_agent"
# Secret used to sign JWTs (required, at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-secret"
# Which AI provider scores jobs: "openai" (default) or "fake" (tests and local runs without a key;
# refused when NODE_ENV=production).
LLM_PROVIDER=openai
# Without a key the server still starts; only POST /jobs/score answers 503. Never commit a real key.
# OPENAI_API_KEY="replace-with-your-openai-key"
# Optional; defaults to gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
