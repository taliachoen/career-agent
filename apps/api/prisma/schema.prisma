generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobSource {
  MANUAL
  EMAIL
}

model Job {
  id          String       @id @default(uuid())
  title       String
  company     String
  description String
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  postings    JobPosting[]
  score       JobScore?

  // Target of JobPosting's composite foreign key (a posting must share its job's owner).
  @@unique([id, userId])
  @@index([userId, createdAt])
}

// A place where a job was seen. One job can have several postings.
model JobPosting {
  id              String    @id @default(uuid())
  jobId           String
  // Always the same as the job's userId; enforced by the composite foreign key.
  userId          String
  url             String
  // Hostname of the url without a leading "www.", e.g. "linkedin.com".
  site            String
  source          JobSource
  // Gmail message id, for postings found in an email.
  sourceMessageId String?
  createdAt       DateTime  @default(now())
  job             Job       @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, url])
  @@index([jobId])
}

// The AI score of a job against the user's profile. One per job; scoring again replaces it.
// It is stale once the profile changes after `scoredAt` (computed, not stored).
model JobScore {
  id       String   @id @default(uuid())
  jobId    String   @unique
  // Always the same as the job's userId; enforced by the composite foreign key.
  userId   String
  // Integer 0-100, checked in code before saving.
  score    Int
  summary  String
  matches  String[]
  gaps     String[]
  // The model that produced this score, e.g. "gpt-6-luna".
  model    String
  scoredAt DateTime @default(now())
  job      Job      @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  // Prisma requires a unique on the composite foreign key's fields for a one-to-one relation;
  // the single-column unique on jobId is what really enforces one score per job.
  @@unique([jobId, userId])
  @@index([userId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  jobs         Job[]
  profile      Profile?
  gmail        GmailConnection?
}

enum GmailConnectionStatus {
  // The user started connecting but there is no token yet. Shown as "not connected".
  PENDING
  CONNECTED
  // Google no longer accepts the refresh token (expired, revoked, ...). The token is deleted.
  NEEDS_RECONNECT
}

// One per user: the Gmail connection. No row means "not connected". Holds secrets, so it is
// never selected whole: see GmailService, which always lists the columns it needs.
model GmailConnection {
  id                    String                @id @default(uuid())
  userId                String                @unique
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                GmailConnectionStatus @default(PENDING)
  googleEmail           String?
  // AES-256-GCM, see token-crypto.ts. The access token is never stored.
  encryptedRefreshToken String?
  // The scope Google granted, checked to be exactly gmail.readonly before saving.
  scope                 String?
  connectedAt           DateTime?
  lastVerifiedAt        DateTime?
  // The pending OAuth flow: a single-use nonce (also inside the signed state) and the PKCE
  // code verifier (encrypted). All three are cleared when the callback consumes them.
  oauthNonce            String?
  oauthCodeVerifier     String?
  oauthExpiresAt        DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

// One per user: the CV and what the user is looking for, both as free text.
// Personal data, so it goes away with the user (Cascade).
model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvText     String
  lookingFor String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
